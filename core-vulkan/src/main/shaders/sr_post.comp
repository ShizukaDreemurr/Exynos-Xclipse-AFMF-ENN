#version 450
// SR bước 2.
//  x2: ảnh HR = bilinear(LR) + phần chênh lệch NPU (12 kênh int8, pixel-shuffle). kênh k = c*4 + i*2 + j (như torch.pixel_shuffle).
//  x1: cùng độ phân giải: ảnh = ảnh gốc + phần chênh lệch (3 kênh) CHỈ trong vùng model (cropX,cropY,lrW,lrH); ngoài vùng giữ nguyên.
// Chênh lệch được nhân trọng số 0..1: 0 ở viền `margin` điểm, tăng dần trong `ramp` điểm (không để lộ đường biên, tránh động HUD ở mép).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uLr;
layout(set = 0, binding = 5) readonly buffer SrOut { uint r[]; };
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D uHr;

layout(push_constant) uniform PC {
    int lrW, lrH, outW, outH;
    int words; int scale;
    float inScale; float outScale;
    int inZp; int outZp;
    int cropX, cropY, margin, ramp, p5, p6;
} pc;

float resid(int k, int x, int y) {
    int idx = k * (pc.lrW * pc.lrH) + y * pc.lrW + x;
    uint w = r[uint(idx) >> 2];
    int b = int((w >> uint((idx & 3) * 8)) & 0xFFu);
    if (b >= 128) b -= 256;
    return float(b - pc.outZp) * pc.outScale;
}

float edgeW(int x, int y) {
    int d = min(min(x, pc.lrW - 1 - x), min(y, pc.lrH - 1 - y));
    return clamp(float(d - pc.margin + 1) / float(max(pc.ramp, 1)), 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.outW || p.y >= pc.outH) return;
    if (pc.scale == 2) {
        int x = p.x >> 1, y = p.y >> 1, j = p.x & 1, i = p.y & 1;
        vec3 base = texture(uLr, (vec2(p) + 0.5) / vec2(float(pc.outW), float(pc.outH))).rgb;
        float wt = edgeW(x, y);
        vec3 o = base + wt * vec3(resid(0 * 4 + i * 2 + j, x, y), resid(1 * 4 + i * 2 + j, x, y), resid(2 * 4 + i * 2 + j, x, y));
        imageStore(uHr, p, vec4(clamp(o, 0.0, 1.0), 1.0));
    } else {
        vec3 base = texelFetch(uLr, p, 0).rgb;
        ivec2 q = p - ivec2(pc.cropX, pc.cropY);
        if (q.x < 0 || q.y < 0 || q.x >= pc.lrW || q.y >= pc.lrH) {
            imageStore(uHr, p, vec4(base, 1.0));
            return;
        }
        float wt = edgeW(q.x, q.y);
        vec3 o = base + wt * vec3(resid(0, q.x, q.y), resid(1, q.x, q.y), resid(2, q.x, q.y));
        imageStore(uHr, p, vec4(clamp(o, 0.0, 1.0), 1.0));
    }
}
