#version 450
// SR bước 2: ảnh HR = bilinear(LR) + phần chênh lệch NPU (12 kênh int8, pixel-shuffle x2).
// kênh k = c*4 + i*2 + j  ->  điểm ảnh HR (2y+i, 2x+j) màu c (giống torch.pixel_shuffle).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uLr;
layout(set = 0, binding = 5) readonly buffer SrOut { uint r[]; };
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D uHr;

layout(push_constant) uniform PC {
    int lrW, lrH, hrW, hrH;
    int words; int pad0;
    float inScale; float outScale;
    int inZp; int outZp;
    int p1, p2, p3, p4, p5, p6;
} pc;

float resid(int c, int i, int j, int x, int y) {
    int k = c * 4 + i * 2 + j;
    int idx = k * (pc.lrW * pc.lrH) + y * pc.lrW + x;
    uint w = r[uint(idx) >> 2];
    int b = int((w >> uint((idx & 3) * 8)) & 0xFFu);
    if (b >= 128) b -= 256;
    return float(b - pc.outZp) * pc.outScale;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.hrW || p.y >= pc.hrH) return;
    int x = p.x >> 1, y = p.y >> 1, j = p.x & 1, i = p.y & 1;
    vec3 base = texture(uLr, (vec2(p) + 0.5) / vec2(float(pc.hrW), float(pc.hrH))).rgb;
    vec3 o = base + vec3(resid(0, i, j, x, y), resid(1, i, j, x, y), resid(2, i, j, x, y));
    imageStore(uHr, p, vec4(clamp(o, 0.0, 1.0), 1.0));
}
