#version 450
// mode 0: chép frame hiện tại. mode 1: nội suy t (backward warp hai phía + mask + occlusion + giữ vùng tĩnh/HUD).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uPrev;
layout(set = 0, binding = 1) uniform sampler2D uCur;
layout(set = 0, binding = 7) uniform sampler2D uFlow;
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 11) uniform sampler2D uAux;
layout(set = 0, binding = 9) readonly buffer Metrics { uint m[]; };

layout(push_constant) uniform PC {
    int srcW, srcH, lowW, lowH, flowW, flowH, outW, outH;
    float t; int mode; int useNN; int pad0;
    float flowScaleX, flowScaleY; float staticThr; float occThr;
} pc;

float maxAbs(vec3 v) { return max(abs(v.x), max(abs(v.y), abs(v.z))); }

// Điểm HUD = đứng yên giữa hai khung VÀ nằm trên biên rõ (chữ, viền nút, thanh máu).
// Vùng phẳng đứng yên không cần bảo vệ (nội suy ra cũng bằng chính nó).
bool hudEdge(vec2 q, vec2 px) {
    vec3 c = texture(uCur, q).rgb;
    if (maxAbs(texture(uPrev, q).rgb - c) >= pc.staticThr) return false;
    float g = max(maxAbs(texture(uCur, q + vec2(px.x, 0.0)).rgb - c), maxAbs(texture(uCur, q + vec2(0.0, px.y)).rgb - c));
    return g > 0.06;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.outW || p.y >= pc.outH) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(float(pc.outW), float(pc.outH));
    vec3 cur = texture(uCur, uv).rgb;

    if (pc.mode == 0) {
        imageStore(outImg, p, vec4(cur, 1.0));
        return;
    }

    // Chuyển cảnh / chuyển động quá lớn: quyết định ngay trên GPU (không cần CPU đọc lại metrics).
    // m[0]: tổng |luma diff|; m[1]/m[2]: tỉ lệ block chạm biên vùng tìm kiếm (chỉ có khi block-match).
    {
        float meanDiff = float(m[0]) / (255.0 * float(pc.lowW) * float(pc.lowH));
        bool cut = meanDiff > 0.28;
        if (pc.useNN == 0 && m[2] > 0u && float(m[1]) / float(m[2]) > 0.35) cut = true;
        if (cut) { imageStore(outImg, p, vec4(cur, 1.0)); return; }
    }

    vec3 prev = texture(uPrev, uv).rgb;
    // Vùng tĩnh (HUD, nút bấm): giữ nguyên frame thật, tránh méo do flow nhiễu.
    if (maxAbs(prev - cur) < pc.staticThr) {
        imageStore(outImg, p, vec4(cur, 1.0));
        return;
    }

    // Nở mặt nạ HUD ~3px: pixel nằm sát chữ/viền HUD giữ nguyên khung thật, flow nền không lem vào HUD.
    if ((pc.pad0 & 1) == 0) {
        vec2 px = 1.0 / vec2(float(pc.outW), float(pc.outH));
        vec2 r = px * 3.0;
        if (hudEdge(uv + vec2(r.x, 0.0), px) || hudEdge(uv - vec2(r.x, 0.0), px) ||
            hudEdge(uv + vec2(0.0, r.y), px) || hudEdge(uv - vec2(0.0, r.y), px)) {
            imageStore(outImg, p, vec4(cur, 1.0));
            return;
        }
    }

    // Flow theo khối 8px dễ bị "halo" ở biên vật thể: thử thêm flow của 4 khối lân cận
    // và chọn ứng viên cho hai phía warp khớp nhau nhất (lỗi nhỏ nhất).
    vec2 off = vec2(4.0 / float(pc.flowW), 4.0 / float(pc.flowH));
    vec4 cand[5];
    cand[0] = texture(uFlow, uv);
    cand[1] = texture(uFlow, uv + vec2(off.x, 0.0));
    cand[2] = texture(uFlow, uv - vec2(off.x, 0.0));
    cand[3] = texture(uFlow, uv + vec2(0.0, off.y));
    cand[4] = texture(uFlow, uv - vec2(0.0, off.y));
    vec4 fl = cand[0];
    vec3 a = texture(uPrev, uv + fl.xy).rgb;
    vec3 b = texture(uCur, uv + fl.zw).rgb;
    float err = maxAbs(a - b);
    for (int i = 1; i < 5; ++i) {
        vec3 ai = texture(uPrev, uv + cand[i].xy).rgb;
        vec3 bi = texture(uCur, uv + cand[i].zw).rgb;
        float ei = maxAbs(ai - bi);
        if (ei < err - 0.01) { err = ei; fl = cand[i]; a = ai; b = bi; }
    }

    // Chống "bóng ma" HUD: nếu điểm lấy mẫu rơi vào vùng tĩnh (HUD/nút) mà pixel này không tĩnh
    // thì phía đó đang kéo HUD vào nền chuyển động -> bỏ phía đó, dùng phía còn lại / khung thật.
    float thr = pc.staticThr * 2.0;
    vec2 qa = uv + fl.xy, qb = uv + fl.zw;
    bool aHud = maxAbs(texture(uPrev, qa).rgb - texture(uCur, qa).rgb) < thr && length(fl.xy) > 0.0015;
    bool bHud = maxAbs(texture(uPrev, qb).rgb - texture(uCur, qb).rgb) < thr && length(fl.zw) > 0.0015;
    if ((pc.pad0 & 1) != 0) { aHud = false; bHud = false; }
    if (aHud && bHud) { imageStore(outImg, p, vec4(cur, 1.0)); return; }
    float mask = (pc.useNN != 0) ? texture(uAux, uv).r : 0.5;  // trọng số phía prev
    if (aHud) { mask = 0.0; err = 0.0; }
    else if (bHud) { mask = 1.0; err = 0.0; }

    // Che khuất: khi hai phía lệch nhau (độ tin cậy thấp), lùi mềm về khung thật; vùng hơi lệch
    // thì nghiêng về phía có biên rõ hơn thay vì trộn đều (đỡ mờ/bóng ma).
    vec3 warped = mix(b, a, mask);
    float w = smoothstep(pc.occThr * 0.5, pc.occThr * 1.2, err);
    vec3 outc = mix(warped, cur, w);
    imageStore(outImg, p, vec4(outc, 1.0));
}
