#version 450
// Chuyển đầu ra NN (NCHW float [5,fh,fw]: F_t->0 xy, F_t->1 xy, mask) sang flowImg / auxImg.
// Flow của NN tính bằng pixel proc-res -> đổi sang UV chuẩn hóa.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 5) buffer NnFlow { float nnFlow[]; };
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D flowImg;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D auxImg;

layout(push_constant) uniform PC {
    int srcW, srcH, lowW, lowH, flowW, flowH, outW, outH;
    float t; int mode; int useNN; int pad0;
    float flowScaleX, flowScaleY; float staticThr; float occThr;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.flowW || p.y >= pc.flowH) return;
    int plane = pc.flowW * pc.flowH;
    int idx = p.y * pc.flowW + p.x;
    vec2 sc = vec2(pc.flowScaleX, pc.flowScaleY);
    vec2 f0 = vec2(nnFlow[0 * plane + idx], nnFlow[1 * plane + idx]) * sc;
    vec2 f1 = vec2(nnFlow[2 * plane + idx], nnFlow[3 * plane + idx]) * sc;
    float mask = clamp(nnFlow[4 * plane + idx], 0.0, 1.0);
    imageStore(flowImg, p, vec4(f0, f1));
    imageStore(auxImg, p, vec4(mask, 0.0, 0.0, 1.0));
}
