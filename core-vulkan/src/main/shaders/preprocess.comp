#version 450
// Thu nhỏ prev/cur về độ phân giải xử lý, ghi lowPrev/lowCur (RGBA8), ghi tensor NN (nếu useNN),
// và cộng dồn |luma diff| để phát hiện chuyển cảnh (metrics[0]).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uPrev;
layout(set = 0, binding = 1) uniform sampler2D uCur;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D lowPrev;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D lowCur;
layout(set = 0, binding = 4) buffer NnIn { float nnIn[]; };
layout(set = 0, binding = 9) buffer Metrics { uint m[]; };

layout(push_constant) uniform PC {
    int srcW, srcH, lowW, lowH, flowW, flowH, outW, outH;
    float t; int mode; int useNN; int pad0;
    float flowScaleX, flowScaleY; float staticThr; float occThr;
} pc;

shared uint sDiff;

vec3 box(sampler2D s, vec2 uv) {
    vec2 d = 0.25 * vec2(float(pc.srcW) / float(pc.lowW), float(pc.srcH) / float(pc.lowH))
                  / vec2(float(pc.srcW), float(pc.srcH));
    return 0.25 * (texture(s, uv + vec2(-d.x, -d.y)).rgb + texture(s, uv + vec2(d.x, -d.y)).rgb +
                   texture(s, uv + vec2(-d.x, d.y)).rgb + texture(s, uv + vec2(d.x, d.y)).rgb);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) sDiff = 0u;
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    uint d8 = 0u;
    if (p.x < pc.lowW && p.y < pc.lowH) {
        vec2 uv = (vec2(p) + 0.5) / vec2(float(pc.lowW), float(pc.lowH));
        vec3 a = box(uPrev, uv);
        vec3 b = box(uCur, uv);
        imageStore(lowPrev, p, vec4(a, 1.0));
        imageStore(lowCur, p, vec4(b, 1.0));

        if (pc.useNN != 0) {
            int plane = pc.lowW * pc.lowH;
            int idx = p.y * pc.lowW + p.x;
            nnIn[0 * plane + idx] = a.r;
            nnIn[1 * plane + idx] = a.g;
            nnIn[2 * plane + idx] = a.b;
            nnIn[3 * plane + idx] = b.r;
            nnIn[4 * plane + idx] = b.g;
            nnIn[5 * plane + idx] = b.b;
        }
        const vec3 W = vec3(0.299, 0.587, 0.114);
        d8 = uint(clamp(abs(dot(a, W) - dot(b, W)), 0.0, 1.0) * 255.0 + 0.5);
    }
    atomicAdd(sDiff, d8);
    barrier();
    if (gl_LocalInvocationIndex == 0u && sDiff != 0u) atomicAdd(m[0], sDiff);
}
